# Copy to .env.local and fill in. Without Supabase vars the app runs in LOCAL DEV mode
# (data stored in ./.data, admin without login). In production Supabase is required.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma-separated emails of admin users (create them in Supabase → Authentication → Users)
ADMIN_EMAILS=you@example.com

# Public contact for privacy / data deletion requests (shown on /privacy)
NEXT_PUBLIC_CONTACT_EMAIL=
